{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "rootDir": "src",
    "strict": true /* enable all strict type-checking options */
  },
  "exclude": ["node_modules", ".vscode-test", "out", "dist"]
}
